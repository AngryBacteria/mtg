{
	"name": "@mtg/server",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"exports": {
		"./router": "./src/routers/router.ts"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"dev": "tsx watch --env-file=.env src/index.ts",
		"db:update": "drizzle-kit push",
		"db:open": "drizzle-kit studio",
		"build": "tsc -p tsconfig.json",
		"start": "node dist/index.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"devDependencies": {
		"@types/node": "24.0.0",
		"drizzle-kit": "1.0.0-rc.4",
		"pino-pretty": "13.1.3",
		"tsx": "4.23.12",
		"typescript": "6.0.2",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@trpc/server": "11.18.0",
		"drizzle-orm": "1.0.0-rc.4",
		"fastify": "5.12.1",
		"pino": "10.3.1",
		"zod": "^4.4.3"
	}
}
