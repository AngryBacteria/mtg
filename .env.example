# HTTP port used by the server.
PORT=3000

# Runtime environment and Pino log level.
NODE_ENV=development
LOG_LEVEL=info

# Local SQLite database file (relative to the server process working directory).
DB_FILE_NAME=mtg.sqlite

# Set to false to skip the background Scryfall import when the server starts.
DOWNLOAD_DEFAULT_CARDS_ON_STARTUP=true
