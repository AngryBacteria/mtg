{
	"name": "mtg",
	"private": true,
	"packageManager": "pnpm@11.2.2",
	"engines": {
		"node": ">=24.0.0",
		"pnpm": ">=11.0.0"
	},
	"scripts": {
		"build": "pnpm -r build",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"dev": "pnpm -r --parallel dev",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"typecheck": "pnpm -r typecheck"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10"
	}
}
